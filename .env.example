# Local development: Copy this file to .env and fill in actual dev values
DATABASE_URL=postgresql://user:password@host/dbname?channel_binding=require&sslmode=require
NOTION_TOKEN=
NOTION_DATABASE_ID=
JWT_SECRET=your-jwt-secret-min-32-chars

SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
VITE_SENTRY_DSN=

# LLM Provider (using OpenRouter for all models)
OPENROUTER_API_KEY=

# GCS bucket for character reference images and generated portraits.
# Defaults to the real production bucket name — only override for local testing against a different bucket.
# See docs/ci-cd/local-dev.md for the Application Default Credentials setup needed to exercise these endpoints locally.
GCS_BUCKET_NAME=

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Google OAuth (login only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8020/api/auth/google/callback
VITE_SHOW_PASSWORD_LOGIN=true

# Local dev escape hatch — pass as x-dev-api-key header; never set in production
DEV_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# Production sets TELEGRAM_WEBHOOK_URL so the bot receives updates via webhook.
# Leave both of the below EMPTY for local dev: the bot loads outbound-only and will
# NOT touch the production webhook. Only set TELEGRAM_ENABLE_POLLING=true if you are
# using a SEPARATE dev bot token — long-polling deletes the webhook of whatever token it runs on.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_ENABLE_POLLING=
