{
  "name": "bedtime-agent",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev:api": "npm run dev -w @bedtime/api",
    "dev:web": "npm run dev -w @bedtime/web",
    "dev:debug": "npm run dev:api 2>&1 | tee /tmp/bedtime-api.log & npm run dev:web 2>&1 | tee /tmp/bedtime-web.log",
    "start": "mkdir -p logs && npm run start -w @bedtime/api 2>&1 | tee -a logs/api.log",
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "notion-import": "tsx packages/core/src/scripts/notion-import.ts",
    "db:migrate": "tsx packages/core/src/db/migrate.ts",
    "create-user": "tsx packages/core/src/scripts/create-user.ts",
    "eval:retrieval": "tsx packages/core/src/scripts/eval-search-past-stories.ts",
    "build:web": "npm run build -w @bedtime/web",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build",
    "lf:traces": "langfuse --env .env api traces list --limit 20",
    "lf:prompts": "langfuse --env .env api prompts list",
    "lf:prompt": "langfuse --env .env api prompts get --name",
    "lf:sessions": "langfuse --env .env api sessions list --limit 20",
    "lf:scores": "langfuse --env .env api score-v2s get-scores --limit 20",
    "lf:datasets": "langfuse --env .env api datasets list"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "langfuse-cli": "^0.0.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^2.1.9"
  }
}
